#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
OS_NAME="$(uname -s)"
ARCH_NAME="$(uname -m)"
CONFIG_DIR="$BASE_DIR/config"
DATA_DIR="$BASE_DIR/data"
LOG_DIR="$BASE_DIR/logs"
CONFIG_FILE="$CONFIG_DIR/config.yaml"
CONFIG_BASE="$CONFIG_DIR/config_base.yaml"
SUB_FILE="$DATA_DIR/subscription.url"

case "$OS_NAME:$ARCH_NAME" in
  Darwin:arm64|Darwin:aarch64) MIHOMO_BIN="$BASE_DIR/bin/mihomo-darwin-arm64" ;;
  Linux:x86_64|Linux:amd64)   MIHOMO_BIN="$BASE_DIR/bin/mihomo-linux-amd64-v3" ;;
  *)                           MIHOMO_BIN="$BASE_DIR/bin/mihomo" ;;
esac

SSR_CONVERTER_BIN="$BASE_DIR/bin/ssr_2_mihomo"
MIHOMO_CTL_BIN="$BASE_DIR/bin/mihomo_ctl"

# macOS 服务路径
PLIST_LABEL="com.local.mihomo.box"
PLIST_AGENT="$HOME/Library/LaunchAgents/${PLIST_LABEL}.plist"
PLIST_DAEMON="/Library/LaunchDaemons/${PLIST_LABEL}.plist"

# Linux 服务路径
SYSTEMD_USER_SERVICE="$HOME/.config/systemd/user/mihomo-box.service"
SYSTEMD_SYS_SERVICE="/etc/systemd/system/mihomo-box.service"

PROXY_ENV_DIR="$HOME/.config/mihomo-box"
PROXY_ENV_FILE="$PROXY_ENV_DIR/proxy.env"

API="http://127.0.0.1:9090"
GROUP="PROXY"
PORT="1087"

GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'

# 从 config.yaml 读取 secret，供所有 API 调用使用
_read_secret() {
  [[ -f "$CONFIG_FILE" ]] || { echo ""; return; }
  local s
  s="$(grep -E '^secret:' "$CONFIG_FILE" | head -1 | sed 's/^secret:[[:space:]]*//' | tr -d '"'"'")"
  echo "$s"
}
SECRET="$(_read_secret)"

# 带鉴权的 curl：secret 非空时自动加 Authorization header
api_curl() {
  if [[ -n "$SECRET" ]]; then
    curl -s -H "Authorization: Bearer $SECRET" "$@"
  else
    curl -s "$@"
  fi
}

mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$LOG_DIR"

line()      { printf '%*s\n' "${COLUMNS:-72}" '' | tr ' ' '='; }
small_line(){ printf '%*s\n' "${COLUMNS:-72}" '' | tr ' ' '-'; }
pause()     { echo; read -r -p "按 Enter 返回菜单..." _; }

# ── 网络服务名（macOS）───────────────────────────────────────────
network_service() {
  [[ "$OS_NAME" != "Darwin" ]] && echo "CLI" && return
  local iface service
  iface="$(route get default 2>/dev/null | awk '/interface:/{print $2; exit}')"
  if [[ -n "${iface:-}" ]]; then
    service="$(networksetup -listallhardwareports | awk -v dev="$iface" '
      BEGIN { RS=""; FS="\n" }
      $0 ~ "Device: " dev { for (i=1;i<=NF;i++) if ($i ~ /^Hardware Port:/) { sub(/^Hardware Port: /,"",$i); print $i; exit } }
    ')"
  fi
  [[ -n "${service:-}" ]] && echo "$service" || echo "Wi-Fi"
}
NET_SERVICE="${MIHOMO_NET_SERVICE:-$(network_service)}"

# ── 环境检查 ─────────────────────────────────────────────────────
check_env() {
  echo "工作目录: $BASE_DIR"
  echo "平台:     $OS_NAME/$ARCH_NAME"
  echo
  local cmds=(curl awk)
  [[ "$OS_NAME" == "Darwin" ]] && cmds+=(networksetup launchctl)
  [[ "$OS_NAME" == "Linux"  ]] && cmds+=(systemctl journalctl)
  for c in "${cmds[@]}"; do
    if command -v "$c" >/dev/null 2>&1; then echo -e "${GREEN}OK${NC}  $c"
    else echo -e "${RED}缺少${NC} $c"; fi
  done
  echo
  [[ -x "$SSR_CONVERTER_BIN" ]] \
    && echo -e "${GREEN}OK${NC}  ssr_2_mihomo" \
    || echo -e "${RED}缺少${NC} ssr_2_mihomo: $SSR_CONVERTER_BIN"
  [[ -x "$MIHOMO_CTL_BIN" ]] \
    && echo -e "${GREEN}OK${NC}  mihomo_ctl" \
    || echo -e "${RED}缺少${NC} mihomo_ctl: $MIHOMO_CTL_BIN"
  if [[ -x "$MIHOMO_BIN" ]]; then
    echo -e "${GREEN}OK${NC}  mihomo 内核: $("$MIHOMO_BIN" -v 2>&1 | head -1)"
  else
    echo -e "${RED}缺少${NC} 内核: $MIHOMO_BIN"
  fi
  [[ -f "$CONFIG_BASE" ]] \
    && echo -e "${GREEN}OK${NC}  config_base.yaml" \
    || echo -e "${YELLOW}缺少${NC} config_base.yaml（请先导入订阅）"
  [[ -f "$CONFIG_FILE" ]] \
    && echo -e "${GREEN}OK${NC}  config.yaml" \
    || echo -e "${YELLOW}缺少${NC} config.yaml（请先导入订阅）"
}

# ── SSR 转换器调用 ────────────────────────────────────────────────
run_ssr_converter() {
  local url="$1"
  if [[ ! -x "$SSR_CONVERTER_BIN" ]]; then
    echo -e "${RED}未找到 SSR 转换器: $SSR_CONVERTER_BIN${NC}"
    return 1
  fi
  "$SSR_CONVERTER_BIN" \
    --url "$url" \
    --proxies-out "$CONFIG_DIR/proxies.yaml" \
    --base "$CONFIG_BASE" \
    --output "$CONFIG_FILE"
}

run_mihomo_ctl() {
  if [[ ! -x "$MIHOMO_CTL_BIN" ]]; then
    echo -e "${RED}未找到 mihomo_ctl: $MIHOMO_CTL_BIN${NC}" >&2
    return 1
  fi
  "$MIHOMO_CTL_BIN" "$@"
}

# ── 订阅管理 ─────────────────────────────────────────────────────
import_subscription() {
  local saved=""
  [[ -f "$SUB_FILE" ]] && saved="$(cat "$SUB_FILE")"
  if [[ -n "$saved" ]]; then
    echo "已保存的链接: $saved"
    read -r -p "直接回车复用，或输入新链接: " url
    [[ -z "$url" ]] && url="$saved"
  else
    read -r -p "请输入 SSR 订阅链接: " url
    [[ -z "$url" ]] && echo "已取消" && return
  fi
  mkdir -p "$DATA_DIR"
  echo "$url" > "$SUB_FILE"
  run_ssr_converter "$url"
}

# ── 服务文件写入 ──────────────────────────────────────────────────
_check_bin() {
  if [[ ! -x "$MIHOMO_BIN" ]]; then
    echo -e "${RED}未找到 mihomo 内核: $MIHOMO_BIN${NC}"; return 1
  fi
}

_plist_body() {
  local dest="$1" user_key="$2"
  mkdir -p "$(dirname "$dest")" "$LOG_DIR"
  cat > "$dest" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key><string>$PLIST_LABEL</string>
    <key>ProgramArguments</key>
    <array>
      <string>$MIHOMO_BIN</string>
      <string>-d</string>
      <string>$CONFIG_DIR</string>
    </array>
    $user_key
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>$LOG_DIR/stdout.log</string>
    <key>StandardErrorPath</key><string>$LOG_DIR/stderr.log</string>
  </dict>
</plist>
PLIST
}

write_launch_agent() {
  _check_bin || return 1
  _plist_body "$PLIST_AGENT" ""
  echo -e "${GREEN}LaunchAgent 已写入: $PLIST_AGENT${NC}"
  echo "  登录后自启，以当前用户身份运行，无需 sudo"
}

write_launch_daemon() {
  _check_bin || return 1
  echo -e "${YELLOW}LaunchDaemon 需要 sudo 写入 /Library/LaunchDaemons/${NC}"
  local user_key="<key>UserName</key><string>$(whoami)</string>"
  sudo bash -c "$(declare -f _plist_body); _plist_body '$PLIST_DAEMON' '$user_key'"
  echo -e "${GREEN}LaunchDaemon 已写入: $PLIST_DAEMON${NC}"
  echo "  开机即启（登录前），以当前用户身份运行"
}

write_systemd_user() {
  _check_bin || return 1
  mkdir -p "$(dirname "$SYSTEMD_USER_SERVICE")"
  cat > "$SYSTEMD_USER_SERVICE" <<SERVICE
[Unit]
Description=mihomo-box (user)
After=network-online.target

[Service]
Type=simple
ExecStart=$MIHOMO_BIN -d $CONFIG_DIR
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
SERVICE
  systemctl --user daemon-reload
  systemctl --user enable mihomo-box.service
  echo -e "${GREEN}systemd user 服务已写入: $SYSTEMD_USER_SERVICE${NC}"
  echo "  登录后自启，以当前用户身份运行，无需 sudo"
  if loginctl show-user "$(whoami)" 2>/dev/null | grep -q "Linger=no"; then
    read -r -p "  是否启用 linger（开机自启，无需登录）? [y/N] " yn
    [[ "$yn" =~ ^[Yy]$ ]] && loginctl enable-linger "$(whoami)" \
      && echo -e "${GREEN}已启用 linger${NC}"
  fi
}

write_systemd_system() {
  _check_bin || return 1
  echo -e "${YELLOW}system 服务需要 sudo 写入 /etc/systemd/system/${NC}"
  sudo tee "$SYSTEMD_SYS_SERVICE" > /dev/null <<SERVICE
[Unit]
Description=mihomo-box (system)
After=network-online.target

[Service]
Type=simple
User=$(whoami)
ExecStart=$MIHOMO_BIN -d $CONFIG_DIR
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
SERVICE
  sudo systemctl daemon-reload
  sudo systemctl enable mihomo-box.service
  echo -e "${GREEN}systemd system 服务已写入: $SYSTEMD_SYS_SERVICE${NC}"
  echo "  开机即启（登录前），以当前用户身份运行"
}

# ── 安装服务（子菜单）────────────────────────────────────────────
setup_service() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo -e "${RED}config.yaml 不存在，请先导入订阅${NC}"; return 1
  fi
  echo
  if [[ "$OS_NAME" == "Darwin" ]]; then
    echo "选择安装方式："
    echo "  1. LaunchAgent  — 登录后自启，无需 sudo（推荐个人使用）"
    echo "  2. LaunchDaemon — 开机即启，需要 sudo（适合共享/服务器场景）"
    echo "  0. 返回"
    read -r -p "请选择 [0-2]: " sc
    case "$sc" in
      1) write_launch_agent ;;
      2) write_launch_daemon ;;
      0) return ;;
      *) echo "无效选择" ;;
    esac
  elif [[ "$OS_NAME" == "Linux" ]]; then
    echo "选择安装方式："
    echo "  1. systemd user   — 登录后自启，无需 sudo（推荐个人使用）"
    echo "  2. systemd system — 开机即启，需要 sudo（适合服务器场景）"
    echo "  0. 返回"
    read -r -p "请选择 [0-2]: " sc
    case "$sc" in
      1) write_systemd_user ;;
      2) write_systemd_system ;;
      0) return ;;
      *) echo "无效选择" ;;
    esac
  else
    echo -e "${RED}暂不支持: $OS_NAME${NC}"; return 1
  fi
}

# ── 服务启停 ──────────────────────────────────────────────────────
_active_plist() {
  # 返回当前已 bootstrap 的 plist 路径（agent 优先）
  if launchctl print "gui/$(id -u)/$PLIST_LABEL" >/dev/null 2>&1; then
    echo "$PLIST_AGENT"
  elif sudo launchctl print "system/$PLIST_LABEL" >/dev/null 2>&1; then
    echo "$PLIST_DAEMON"
  else
    # 未运行，用已存在的文件推断
    [[ -f "$PLIST_AGENT" ]] && echo "$PLIST_AGENT" || echo "$PLIST_DAEMON"
  fi
}

start_service() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    local plist; plist="$(_active_plist)"
    if [[ "$plist" == "$PLIST_DAEMON" ]]; then
      [[ ! -f "$PLIST_DAEMON" ]] && write_launch_daemon
      sudo launchctl bootout  system "$PLIST_DAEMON" >/dev/null 2>&1 || true
      sudo launchctl bootstrap system "$PLIST_DAEMON"
      sudo launchctl kickstart -k "system/$PLIST_LABEL"
    else
      [[ ! -f "$PLIST_AGENT" ]] && write_launch_agent
      launchctl bootout  "gui/$(id -u)" "$PLIST_AGENT" >/dev/null 2>&1 || true
      launchctl bootstrap "gui/$(id -u)" "$PLIST_AGENT"
      launchctl kickstart -k "gui/$(id -u)/$PLIST_LABEL"
    fi
  elif [[ "$OS_NAME" == "Linux" ]]; then
    if [[ -f "$SYSTEMD_SYS_SERVICE" ]]; then
      sudo systemctl start mihomo-box.service
    else
      [[ ! -f "$SYSTEMD_USER_SERVICE" ]] && write_systemd_user
      systemctl --user start mihomo-box.service
    fi
  else
    echo -e "${RED}暂不支持: $OS_NAME${NC}"; return 1
  fi
  echo -e "${GREEN}Mihomo 已启动${NC}"
}

stop_service() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    launchctl bootout "gui/$(id -u)" "$PLIST_AGENT" >/dev/null 2>&1 || true
    sudo launchctl bootout system "$PLIST_DAEMON" >/dev/null 2>&1 || true
  elif [[ "$OS_NAME" == "Linux" ]]; then
    systemctl --user stop mihomo-box.service >/dev/null 2>&1 || true
    sudo systemctl stop mihomo-box.service >/dev/null 2>&1 || true
  fi
  echo -e "${GREEN}Mihomo 已停止${NC}"
}

restart_service() { stop_service; sleep 1; start_service; }

# ── 代理开关 ──────────────────────────────────────────────────────
ensure_linux_proxy_source() {
  local line="[ -f \"$PROXY_ENV_FILE\" ] && . \"$PROXY_ENV_FILE\""
  for rc in "$HOME/.bashrc" "$HOME/.profile"; do
    [[ -f "$rc" ]] || touch "$rc"
    grep -F "$PROXY_ENV_FILE" "$rc" >/dev/null 2>&1 || {
      printf '\n# mihomo-box proxy env\n%s\n' "$line" >> "$rc"
    }
  done
}

proxy_on() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    networksetup -setwebproxy          "$NET_SERVICE" 127.0.0.1 "$PORT"
    networksetup -setsecurewebproxy    "$NET_SERVICE" 127.0.0.1 "$PORT"
    networksetup -setsocksfirewallproxy "$NET_SERVICE" 127.0.0.1 "$PORT"
    networksetup -setwebproxystate          "$NET_SERVICE" on
    networksetup -setsecurewebproxystate    "$NET_SERVICE" on
    networksetup -setsocksfirewallproxystate "$NET_SERVICE" on
    echo -e "${GREEN}系统代理已打开: $NET_SERVICE -> 127.0.0.1:$PORT${NC}"
    return
  fi
  if [[ "$OS_NAME" == "Linux" ]]; then
    mkdir -p "$PROXY_ENV_DIR"
    cat > "$PROXY_ENV_FILE" <<PROXY
export http_proxy="http://127.0.0.1:$PORT"
export https_proxy="http://127.0.0.1:$PORT"
export all_proxy="socks5h://127.0.0.1:$PORT"
export HTTP_PROXY="\$http_proxy"
export HTTPS_PROXY="\$https_proxy"
export ALL_PROXY="\$all_proxy"
export no_proxy="localhost,127.0.0.1,::1"
export NO_PROXY="\$no_proxy"
PROXY
    ensure_linux_proxy_source
    echo -e "${GREEN}命令行代理已打开: 127.0.0.1:$PORT${NC}"
    echo "新 terminal 自动生效；当前 terminal 执行: source \"$PROXY_ENV_FILE\""
    return
  fi
  echo -e "${RED}暂不支持: $OS_NAME${NC}"
}

proxy_off() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    networksetup -setwebproxystate          "$NET_SERVICE" off
    networksetup -setsecurewebproxystate    "$NET_SERVICE" off
    networksetup -setsocksfirewallproxystate "$NET_SERVICE" off
    echo -e "${GREEN}系统代理已关闭: $NET_SERVICE${NC}"
    return
  fi
  if [[ "$OS_NAME" == "Linux" ]]; then
    : > "$PROXY_ENV_FILE"
    echo -e "${GREEN}命令行代理已关闭${NC}"
    echo "新 terminal 自动生效；当前 terminal 执行: unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY"
    return
  fi
  echo -e "${RED}暂不支持: $OS_NAME${NC}"
}

# ── 状态检测 ──────────────────────────────────────────────────────
api_ok()     { api_curl --max-time 2 "$API/proxies/$GROUP" >/dev/null 2>&1; }

service_ok() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    launchctl print "gui/$(id -u)/$PLIST_LABEL" >/dev/null 2>&1 ||
    sudo launchctl print "system/$PLIST_LABEL" >/dev/null 2>&1
  elif [[ "$OS_NAME" == "Linux" ]]; then
    systemctl --user is-active --quiet mihomo-box.service 2>/dev/null ||
    systemctl is-active --quiet mihomo-box.service 2>/dev/null
  else
    return 1
  fi
}

proxy_ok() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    [[ "$(networksetup -getwebproxy "$NET_SERVICE" 2>/dev/null | awk -F': ' '/^Enabled:/{print $2; exit}')" == "Yes" ]]
  else
    [[ -s "$PROXY_ENV_FILE" ]]
  fi
}

current_node() {
  # 从 API 响应里提取 "now" 字段（compact JSON，无空格）
  api_curl --max-time 2 "$API/proxies/$GROUP" 2>/dev/null \
    | grep -o '"now":"[^"]*"' | cut -d'"' -f4 || echo "-"
}

status_bar() {
  local svc proxy node
  service_ok && svc="${GREEN}开启${NC}" || svc="${RED}关闭${NC}"
  proxy_ok   && proxy="${GREEN}开启${NC}" || proxy="${RED}关闭${NC}"
  node="$(current_node 2>/dev/null || echo '-')"
  echo -e "Mihomo 服务：$svc"
  [[ "$OS_NAME" == "Linux" ]] \
    && echo -e "命令行代理：$proxy" \
    || echo -e "macOS 系统代理：$proxy"
  echo -e "当前节点：${YELLOW}${node}${NC}"
}

# ── 节点选择（从 proxies.yaml 读取，无需 API GET）────────────────
select_node() {
  local proxies_file="$CONFIG_DIR/proxies.yaml"
  if [[ ! -f "$proxies_file" ]]; then
    echo -e "${RED}proxies.yaml 不存在，请先导入订阅${NC}"; return 1
  fi

  # 提取 proxies: 块里所有 name 值（去掉 JSON 引号）
  local -a names
  while IFS= read -r name; do
    names+=("$name")
  done < <(awk '
    /^proxies:/     { in_proxies=1; next }
    /^proxy-groups:/ { in_proxies=0 }
    in_proxies && /^  - name:/ {
      sub(/^  - name: /, ""); gsub(/^"|"$/, ""); print
    }
  ' "$proxies_file")

  if [[ ${#names[@]} -eq 0 ]]; then
    echo -e "${RED}proxies.yaml 中没有找到节点${NC}"; return 1
  fi

  local current; current="$(current_node 2>/dev/null || echo '-')"
  echo "当前节点: $current"
  echo "------------------------------------------------------------"
  for i in "${!names[@]}"; do
    printf "  %3d. %s\n" $((i+1)) "${names[$i]}"
  done
  echo "------------------------------------------------------------"
  echo "    0. 返回"

  read -r -p "请选择节点编号: " idx
  [[ "$idx" == "0" || -z "$idx" ]] && return
  if ! [[ "$idx" =~ ^[0-9]+$ ]] || (( idx < 1 || idx > ${#names[@]} )); then
    echo -e "${RED}编号无效${NC}"; return 1
  fi

  local selected="${names[$((idx-1))]}"
  api_curl -X PUT "$API/proxies/$GROUP" \
    -H "Content-Type: application/json" \
    -d "{\"name\":\"$selected\"}" >/dev/null
  echo -e "${GREEN}已切换到: $selected${NC}"
}

# ── 日志 / 配置 ───────────────────────────────────────────────────
logs() {
  if [[ "$OS_NAME" == "Linux" ]]; then
    journalctl --user -u mihomo-box.service -n 80 --no-pager 2>/dev/null || echo "暂无"
    return
  fi
  echo "=== stderr (last 60) ==="; tail -n 60 "$LOG_DIR/stderr.log" 2>/dev/null || echo "暂无"
  echo; echo "=== stdout (last 20) ==="; tail -n 20 "$LOG_DIR/stdout.log" 2>/dev/null || echo "暂无"
}

edit_base_config() {
  if [[ ! -f "$CONFIG_BASE" ]]; then
    echo -e "${RED}$CONFIG_BASE 不存在${NC}"
    return 1
  fi
  ${EDITOR:-nano} "$CONFIG_BASE"
  echo
  echo "修改已保存。如需生效请重新导入订阅（选项 2）重新合并 config.yaml，然后重启服务（选项 6）。"
  pause
}

# ── 主菜单 ────────────────────────────────────────────────────────
while true; do
  clear 2>/dev/null || true
  line
  echo -e "${GREEN}  Mihomo-Box 管理菜单${NC}"
  line
  status_bar
  small_line
  echo "  目录: $BASE_DIR   平台: $OS_NAME/$ARCH_NAME"
  line
  echo "  1.  检查环境"
  echo "  2.  导入 / 更新 SSR 订阅"
  small_line
  echo "  3.  安装服务（写入启动项）"
  echo "  4.  启动服务"
  echo "  5.  停止服务"
  echo "  6.  重启服务"
  small_line
  if [[ "$OS_NAME" == "Linux" ]]; then
    echo "  7.  打开命令行代理"
    echo "  8.  关闭命令行代理"
  else
    echo "  7.  打开 macOS 系统代理"
    echo "  8.  关闭 macOS 系统代理"
  fi
  small_line
  echo "  9.  选择节点"
  echo "  10. 查看日志"
  echo "  11. 编辑基础配置 (config_base.yaml)"
  echo "  0.  退出"
  line
  read -r -p "  请输入选择 [0-11]: " c
  case "$c" in
    1)  check_env;           pause ;;
    2)  import_subscription; pause ;;
    3)  setup_service;       pause ;;
    4)  start_service;       pause ;;
    5)  stop_service;        pause ;;
    6)  restart_service;     pause ;;
    7)  proxy_on;            pause ;;
    8)  proxy_off;           pause ;;
    9)  select_node;         pause ;;
    10) logs;                pause ;;
    11) edit_base_config ;;
    0)  exit 0 ;;
    *)  echo "无效选择"; pause ;;
  esac
done
