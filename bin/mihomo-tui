#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
OS_NAME="$(uname -s)"
ARCH_NAME="$(uname -m)"
CONFIG_DIR="$BASE_DIR/config"
DATA_DIR="$BASE_DIR/data"
LOG_DIR="$BASE_DIR/logs"
SERVICE_DIR="$BASE_DIR/service"
CONFIG_FILE="$CONFIG_DIR/config.yaml"
SUB_FILE="$DATA_DIR/subscription.url"
case "$OS_NAME:$ARCH_NAME" in
  Darwin:arm64|Darwin:aarch64) MIHOMO_BIN="$BASE_DIR/bin/mihomo-darwin-arm64" ;;
  Linux:x86_64|Linux:amd64) MIHOMO_BIN="$BASE_DIR/bin/mihomo-linux-amd64-v3" ;;
  *) MIHOMO_BIN="$BASE_DIR/bin/mihomo" ;;
esac
SSR_CONVERTER_BIN="$BASE_DIR/bin/ssr_2_mihomo"
SSR_CONVERTER_SRC="$BASE_DIR/cmd/ssr_2_mihomo/main.go"
MIHOMO_CTL_BIN="$BASE_DIR/bin/mihomo_ctl"
MIHOMO_CTL_SRC="$BASE_DIR/cmd/mihomo_ctl/main.go"
PLIST="$HOME/Library/LaunchAgents/com.local.mihomo.box.plist"
SYSTEMD_SERVICE="$HOME/.config/systemd/user/mihomo-box.service"
PROXY_ENV_DIR="$HOME/.config/mihomo-box"
PROXY_ENV_FILE="$PROXY_ENV_DIR/proxy.env"
API="http://127.0.0.1:9090"
GROUP="PROXY"
PORT="1087"

GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'

mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$LOG_DIR" "$SERVICE_DIR"

line(){ printf '%*s\n' "${COLUMNS:-72}" '' | tr ' ' '='; }
small_line(){ printf '%*s\n' "${COLUMNS:-72}" '' | tr ' ' '-'; }
pause(){ echo; read -r -p "按 Enter 返回菜单..." _; }

network_service() {
  if [[ "$OS_NAME" != "Darwin" ]]; then
    echo "CLI"
    return
  fi
  local iface service
  iface="$(route get default 2>/dev/null | awk '/interface:/{print $2; exit}')"
  if [[ -n "${iface:-}" ]]; then
    service="$(networksetup -listallhardwareports | awk -v dev="$iface" '
      BEGIN { RS=""; FS="\n" }
      $0 ~ "Device: " dev { for (i=1;i<=NF;i++) if ($i ~ /^Hardware Port:/) { sub(/^Hardware Port: /,"",$i); print $i; exit } }
    ')"
  fi
  [[ -n "${service:-}" ]] && echo "$service" || echo "Wi-Fi"
}
NET_SERVICE="${MIHOMO_NET_SERVICE:-$(network_service)}"

check_env() {
  echo "工作目录: $BASE_DIR"
  echo "平台: $OS_NAME/$ARCH_NAME"
  echo "代理环境: $NET_SERVICE"
  echo
  local commands=(curl awk sed)
  if [[ "$OS_NAME" == "Darwin" ]]; then
    commands+=(networksetup launchctl)
  elif [[ "$OS_NAME" == "Linux" ]]; then
    commands+=(systemctl journalctl)
  fi
  for c in "${commands[@]}"; do
    if command -v "$c" >/dev/null 2>&1; then echo -e "${GREEN}OK${NC} $c"; else echo -e "${RED}缺少${NC} $c"; fi
  done
  if [[ -x "$SSR_CONVERTER_BIN" ]]; then
    echo -e "${GREEN}OK${NC} Go SSR 转换器: $SSR_CONVERTER_BIN"
  elif command -v go >/dev/null 2>&1 && [[ -f "$SSR_CONVERTER_SRC" ]]; then
    echo -e "${GREEN}OK${NC} Go 工具链，可直接运行: $SSR_CONVERTER_SRC"
  else
    echo -e "${YELLOW}缺少 Go SSR 转换器${NC}"
    echo "可执行: go build -o bin/ssr_2_mihomo cmd/ssr_2_mihomo/main.go"
  fi
  if [[ -x "$MIHOMO_CTL_BIN" ]]; then
    echo -e "${GREEN}OK${NC} Go 菜单辅助工具: $MIHOMO_CTL_BIN"
  elif command -v go >/dev/null 2>&1 && [[ -f "$MIHOMO_CTL_SRC" ]]; then
    echo -e "${GREEN}OK${NC} Go 工具链，可直接运行: $MIHOMO_CTL_SRC"
  else
    echo -e "${YELLOW}缺少 Go 菜单辅助工具${NC}"
    echo "可执行: go build -o bin/mihomo_ctl cmd/mihomo_ctl/main.go"
  fi
  if [[ -x "$MIHOMO_BIN" ]]; then "$MIHOMO_BIN" -v || true; else echo -e "${YELLOW}未找到内核: $MIHOMO_BIN${NC}"; echo "可执行: ./bin/fetch-mihomo.sh"; fi
}

run_ssr_converter() {
  local url="$1"
  if command -v go >/dev/null 2>&1 && [[ -f "$SSR_CONVERTER_SRC" ]]; then
    if [[ ! -x "$SSR_CONVERTER_BIN" || "$SSR_CONVERTER_SRC" -nt "$SSR_CONVERTER_BIN" ]]; then
      go run "$SSR_CONVERTER_SRC" --url "$url" --output "$CONFIG_FILE" --mixed-port "$PORT" --api "${API#http://}" --group "$GROUP"
      return
    fi
  fi
  if [[ -x "$SSR_CONVERTER_BIN" ]]; then
    "$SSR_CONVERTER_BIN" --url "$url" --output "$CONFIG_FILE" --mixed-port "$PORT" --api "${API#http://}" --group "$GROUP"
    return
  fi
  if command -v go >/dev/null 2>&1 && [[ -f "$SSR_CONVERTER_SRC" ]]; then
    go run "$SSR_CONVERTER_SRC" --url "$url" --output "$CONFIG_FILE" --mixed-port "$PORT" --api "${API#http://}" --group "$GROUP"
    return
  fi
  echo -e "${RED}未找到 Go SSR 转换器${NC}"
  echo "请先执行:"
  echo "  go build -o bin/ssr_2_mihomo cmd/ssr_2_mihomo/main.go"
  return 1
}

run_mihomo_ctl() {
  if command -v go >/dev/null 2>&1 && [[ -f "$MIHOMO_CTL_SRC" ]]; then
    if [[ ! -x "$MIHOMO_CTL_BIN" || "$MIHOMO_CTL_SRC" -nt "$MIHOMO_CTL_BIN" ]]; then
      go run "$MIHOMO_CTL_SRC" "$@"
      return
    fi
  fi
  if [[ -x "$MIHOMO_CTL_BIN" ]]; then
    "$MIHOMO_CTL_BIN" "$@"
    return
  fi
  if command -v go >/dev/null 2>&1 && [[ -f "$MIHOMO_CTL_SRC" ]]; then
    go run "$MIHOMO_CTL_SRC" "$@"
    return
  fi
  echo -e "${RED}未找到 Go 菜单辅助工具${NC}" >&2
  echo "请先执行:" >&2
  echo "  go build -o bin/mihomo_ctl cmd/mihomo_ctl/main.go" >&2
  return 1
}

import_subscription() {
  read -r -p "请输入 SSR 订阅链接: " url
  [[ -z "$url" ]] && echo "已取消" && return
  echo "$url" > "$SUB_FILE"
  run_ssr_converter "$url"
}

update_subscription() {
  if [[ ! -f "$SUB_FILE" ]]; then echo -e "${RED}还没有订阅链接，请先导入${NC}"; return 1; fi
  run_ssr_converter "$(cat "$SUB_FILE")"
}

write_launchd_plist() {
  if [[ ! -x "$MIHOMO_BIN" ]]; then echo -e "${RED}未找到 mihomo 内核: $MIHOMO_BIN${NC}"; return 1; fi
  if [[ ! -f "$CONFIG_FILE" ]]; then cp "$CONFIG_DIR/config.yaml.example" "$CONFIG_FILE"; fi
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key><string>com.local.mihomo.box</string>
    <key>ProgramArguments</key>
    <array>
      <string>$MIHOMO_BIN</string>
      <string>-d</string>
      <string>$CONFIG_DIR</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>$LOG_DIR/stdout.log</string>
    <key>StandardErrorPath</key><string>$LOG_DIR/stderr.log</string>
  </dict>
</plist>
PLIST
}

write_systemd_service() {
  if [[ ! -x "$MIHOMO_BIN" ]]; then echo -e "${RED}未找到 mihomo 内核: $MIHOMO_BIN${NC}"; return 1; fi
  if [[ ! -f "$CONFIG_FILE" ]]; then cp "$CONFIG_DIR/config.yaml.example" "$CONFIG_FILE"; fi
  mkdir -p "$(dirname "$SYSTEMD_SERVICE")"
  cat > "$SYSTEMD_SERVICE" <<SERVICE
[Unit]
Description=mihomo-box user service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=$BASE_DIR
ExecStart=$MIHOMO_BIN -d $CONFIG_DIR
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
SERVICE
}

start_service() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    write_launchd_plist
    launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    launchctl enable "gui/$(id -u)/com.local.mihomo.box"
    launchctl kickstart -k "gui/$(id -u)/com.local.mihomo.box"
  elif [[ "$OS_NAME" == "Linux" ]]; then
    write_systemd_service
    systemctl --user daemon-reload
    systemctl --user enable --now mihomo-box.service
  else
    echo -e "${RED}暂不支持当前系统: $OS_NAME${NC}"
    return 1
  fi
  echo -e "${GREEN}Mihomo 服务已启动${NC}"
}

stop_service() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true
  elif [[ "$OS_NAME" == "Linux" ]]; then
    systemctl --user disable --now mihomo-box.service >/dev/null 2>&1 || true
  fi
  echo -e "${GREEN}Mihomo 服务已停止${NC}"
}

restart_service(){ stop_service; sleep 1; start_service; }

ensure_linux_proxy_source() {
  local marker="# mihomo-box proxy env"
  local line="[ -f \"$PROXY_ENV_FILE\" ] && . \"$PROXY_ENV_FILE\""
  local rc
  for rc in "$HOME/.bashrc" "$HOME/.profile"; do
    [[ -f "$rc" ]] || touch "$rc"
    if ! grep -F "$PROXY_ENV_FILE" "$rc" >/dev/null 2>&1; then
      {
        echo
        echo "$marker"
        echo "$line"
      } >> "$rc"
    fi
  done
}

proxy_on() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    networksetup -setwebproxy "$NET_SERVICE" 127.0.0.1 "$PORT"
    networksetup -setsecurewebproxy "$NET_SERVICE" 127.0.0.1 "$PORT"
    networksetup -setsocksfirewallproxy "$NET_SERVICE" 127.0.0.1 "$PORT"
    networksetup -setwebproxystate "$NET_SERVICE" on
    networksetup -setsecurewebproxystate "$NET_SERVICE" on
    networksetup -setsocksfirewallproxystate "$NET_SERVICE" on
    echo -e "${GREEN}系统代理已打开: $NET_SERVICE -> 127.0.0.1:$PORT${NC}"
    return
  fi
  if [[ "$OS_NAME" == "Linux" ]]; then
    mkdir -p "$PROXY_ENV_DIR"
    cat > "$PROXY_ENV_FILE" <<PROXY
export http_proxy="http://127.0.0.1:$PORT"
export https_proxy="http://127.0.0.1:$PORT"
export all_proxy="socks5h://127.0.0.1:$PORT"
export HTTP_PROXY="\$http_proxy"
export HTTPS_PROXY="\$https_proxy"
export ALL_PROXY="\$all_proxy"
export no_proxy="localhost,127.0.0.1,::1"
export NO_PROXY="\$no_proxy"
PROXY
    ensure_linux_proxy_source
    echo -e "${GREEN}命令行代理已打开: 127.0.0.1:$PORT${NC}"
    echo "新打开的 terminal 会自动生效；当前 terminal 可执行："
    echo "  source \"$PROXY_ENV_FILE\""
    return
  fi
  echo -e "${RED}暂不支持当前系统: $OS_NAME${NC}"
}

proxy_off() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    networksetup -setwebproxystate "$NET_SERVICE" off
    networksetup -setsecurewebproxystate "$NET_SERVICE" off
    networksetup -setsocksfirewallproxystate "$NET_SERVICE" off
    echo -e "${GREEN}系统代理已关闭: $NET_SERVICE${NC}"
    return
  fi
  if [[ "$OS_NAME" == "Linux" ]]; then
    mkdir -p "$PROXY_ENV_DIR"
    : > "$PROXY_ENV_FILE"
    echo -e "${GREEN}命令行代理已关闭${NC}"
    echo "新打开的 terminal 会自动生效；当前 terminal 可执行："
    echo "  unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY"
    return
  fi
  echo -e "${RED}暂不支持当前系统: $OS_NAME${NC}"
}

api_ok(){ curl -s --max-time 2 "$API/proxies/$GROUP" >/dev/null 2>&1; }

service_ok() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    launchctl print "gui/$(id -u)/com.local.mihomo.box" >/dev/null 2>&1
  elif [[ "$OS_NAME" == "Linux" ]]; then
    systemctl --user is-active --quiet mihomo-box.service >/dev/null 2>&1
  else
    return 1
  fi
}

web_proxy_enabled() {
  if [[ "$OS_NAME" != "Darwin" ]]; then
    if [[ -s "$PROXY_ENV_FILE" ]]; then echo "Yes"; else echo "No"; fi
    return
  fi
  local value
  value="$(networksetup -getwebproxy "$NET_SERVICE" 2>/dev/null | awk -F': ' '/^Enabled:/{print $2; found=1; exit} END{if (!found) print "No"}' || true)"
  echo "${value:-No}"
}

proxy_ok(){ [[ "$(web_proxy_enabled)" == "Yes" ]]; }

current_node() {
  if ! api_ok; then
    echo "API 未连接"
    return 1
  fi
  local tmp node rc
  tmp="$(mktemp)"
  curl -s "$API/proxies/$GROUP" > "$tmp" || {
    rm -f "$tmp"
    echo "API 未连接"
    return 1
  }
  node="$(run_mihomo_ctl now "$tmp" 2>/dev/null)" || rc=$?
  rm -f "$tmp"
  if [[ -n "${rc:-}" || -z "$node" ]]; then
    echo "未知"
    return 1
  fi
  echo "$node"
}

status_bar() {
  local service_text proxy_text node
  if service_ok; then service_text="${GREEN}开启${NC}"; else service_text="${RED}关闭${NC}"; fi
  if proxy_ok; then proxy_text="${GREEN}开启${NC}"; else proxy_text="${RED}关闭${NC}"; fi
  node="$(current_node || true)"

  echo -e "mihomo 服务：$service_text"
  if [[ "$OS_NAME" == "Linux" ]]; then
    echo -e "命令行代理：$proxy_text"
  else
    echo -e "macOS 系统代理：$proxy_text"
  fi
  echo -e "当前站点：${YELLOW}${node}${NC}"
}

select_node() {
  if ! api_ok; then echo -e "${RED}无法连接 Mihomo API: $API${NC}"; echo "请先启动服务。"; return 1; fi
  local tmp idx selected
  tmp="$(mktemp)"
  curl -s "$API/proxies/$GROUP" > "$tmp"
  run_mihomo_ctl list "$tmp"
  read -r -p "请选择节点编号: " idx
  [[ "$idx" == "0" || -z "$idx" ]] && rm -f "$tmp" && return
  selected="$(run_mihomo_ctl pick "$tmp" "$idx")" || { echo -e "${RED}编号无效${NC}"; rm -f "$tmp"; return 1; }
  rm -f "$tmp"
  run_mihomo_ctl payload "$selected" > /tmp/mihomo_select_payload.json
  curl -s -X PUT "$API/proxies/$GROUP" -H "Content-Type: application/json" --data-binary @/tmp/mihomo_select_payload.json >/dev/null
  rm -f /tmp/mihomo_select_payload.json
  echo -e "${GREEN}已切换到: $selected${NC}"
}

status() {
  echo "工作目录: $BASE_DIR"
  echo "配置文件: $CONFIG_FILE"
  echo "平台: $OS_NAME/$ARCH_NAME"
  echo "代理环境: $NET_SERVICE"
  echo "API: $API"
  echo
  echo -e "${BLUE}服务:${NC}"
  if service_ok; then echo -e "${GREEN}运行中${NC}"; else echo -e "${YELLOW}未运行${NC}"; fi
  echo
  echo -e "${BLUE}代理:${NC}"
  if [[ "$OS_NAME" == "Darwin" ]]; then
    networksetup -getwebproxy "$NET_SERVICE" || true
  elif [[ -s "$PROXY_ENV_FILE" ]]; then
    cat "$PROXY_ENV_FILE"
  else
    echo "未开启"
  fi
  echo
  echo -e "${BLUE}当前节点:${NC}"
  current_node || true
}

logs(){
  if [[ "$OS_NAME" == "Linux" ]]; then
    journalctl --user -u mihomo-box.service -n 80 --no-pager 2>/dev/null || echo "暂无"
    return
  fi
  echo "stderr:"; tail -n 60 "$LOG_DIR/stderr.log" 2>/dev/null || echo "暂无"; echo; echo "stdout:"; tail -n 20 "$LOG_DIR/stdout.log" 2>/dev/null || echo "暂无"
}
edit_config(){ ${EDITOR:-nano} "$CONFIG_FILE"; }
open_dir(){ open "$BASE_DIR"; }

while true; do
  clear 2>/dev/null || true
  line
  echo -e "${GREEN}Mihomo SSR 管理器${NC}"
  line
  status_bar
  small_line
  echo "目录: $BASE_DIR"
  echo "平台: $OS_NAME/$ARCH_NAME"
  line
  echo "1. 检查环境"
  echo "2. 导入 SSR 订阅链接，并生成配置（Go）"
  echo "3. 更新订阅并重新生成配置"
  echo "4. 启动 Mihomo 服务"
  echo "5. 停止 Mihomo 服务"
  echo "6. 重启 Mihomo 服务"
  if [[ "$OS_NAME" == "Linux" ]]; then
    echo "7. 打开命令行代理"
    echo "8. 关闭命令行代理"
  else
    echo "7. 打开 macOS 系统代理"
    echo "8. 关闭 macOS 系统代理"
  fi
  echo "9. 选择代理站点 / 节点"
  echo "10. 刷新状态"
  echo "11. 查看日志"
  echo "12. 编辑 config.yaml"
  echo "13. 打开工作目录"
  echo "0. 退出"
  line
  read -r -p "请输入选择 [0-13]: " c
  case "$c" in
    1) check_env; pause;;
    2) import_subscription; pause;;
    3) update_subscription; pause;;
    4) start_service; pause;;
    5) stop_service; pause;;
    6) restart_service; pause;;
    7) proxy_on; pause;;
    8) proxy_off; pause;;
    9) select_node; pause;;
    10) status; pause;;
    11) logs; pause;;
    12) edit_config;;
    13) open_dir; pause;;
    0) exit 0;;
    *) echo "无效选择"; pause;;
  esac
done
