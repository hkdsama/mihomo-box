#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
OS_NAME="$(uname -s)"
ARCH_NAME="$(uname -m)"
CONFIG_DIR="$BASE_DIR/config"
DATA_DIR="$BASE_DIR/data"
LOG_DIR="$BASE_DIR/logs"
CONFIG_FILE="$CONFIG_DIR/config.yaml"
CONFIG_BASE="$CONFIG_DIR/config_base.yaml"
SUB_FILE="$DATA_DIR/subscription.url"

case "$OS_NAME:$ARCH_NAME" in
  Darwin:arm64|Darwin:aarch64) MIHOMO_BIN="$BASE_DIR/bin/mihomo-darwin-arm64" ;;
  Linux:x86_64|Linux:amd64)   MIHOMO_BIN="$BASE_DIR/bin/mihomo-linux-amd64-v3" ;;
  *)                           MIHOMO_BIN="$BASE_DIR/bin/mihomo" ;;
esac

SSR_CONVERTER_BIN="$BASE_DIR/bin/ssr_2_mihomo"
MIHOMO_CTL_BIN="$BASE_DIR/bin/mihomo_ctl"

# macOS: LaunchAgent（用户级，登录后自启，KeepAlive 自动重启）
PLIST="$HOME/Library/LaunchAgents/com.local.mihomo.box.plist"
PLIST_LABEL="com.local.mihomo.box"

# Linux: systemd --user
SYSTEMD_SERVICE="$HOME/.config/systemd/user/mihomo-box.service"

PROXY_ENV_DIR="$HOME/.config/mihomo-box"
PROXY_ENV_FILE="$PROXY_ENV_DIR/proxy.env"

API="http://127.0.0.1:9090"
GROUP="PROXY"
PORT="1087"

GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'

mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$LOG_DIR"

line()      { printf '%*s\n' "${COLUMNS:-72}" '' | tr ' ' '='; }
small_line(){ printf '%*s\n' "${COLUMNS:-72}" '' | tr ' ' '-'; }
pause()     { echo; read -r -p "按 Enter 返回菜单..." _; }

# ── 网络服务名（macOS）───────────────────────────────────────────
network_service() {
  [[ "$OS_NAME" != "Darwin" ]] && echo "CLI" && return
  local iface service
  iface="$(route get default 2>/dev/null | awk '/interface:/{print $2; exit}')"
  if [[ -n "${iface:-}" ]]; then
    service="$(networksetup -listallhardwareports | awk -v dev="$iface" '
      BEGIN { RS=""; FS="\n" }
      $0 ~ "Device: " dev { for (i=1;i<=NF;i++) if ($i ~ /^Hardware Port:/) { sub(/^Hardware Port: /,"",$i); print $i; exit } }
    ')"
  fi
  [[ -n "${service:-}" ]] && echo "$service" || echo "Wi-Fi"
}
NET_SERVICE="${MIHOMO_NET_SERVICE:-$(network_service)}"

# ── 环境检查 ─────────────────────────────────────────────────────
check_env() {
  echo "工作目录: $BASE_DIR"
  echo "平台:     $OS_NAME/$ARCH_NAME"
  echo
  local cmds=(curl awk)
  [[ "$OS_NAME" == "Darwin" ]] && cmds+=(networksetup launchctl)
  [[ "$OS_NAME" == "Linux"  ]] && cmds+=(systemctl journalctl)
  for c in "${cmds[@]}"; do
    if command -v "$c" >/dev/null 2>&1; then echo -e "${GREEN}OK${NC}  $c"
    else echo -e "${RED}缺少${NC} $c"; fi
  done
  echo
  [[ -x "$SSR_CONVERTER_BIN" ]] \
    && echo -e "${GREEN}OK${NC}  ssr_2_mihomo" \
    || echo -e "${RED}缺少${NC} ssr_2_mihomo: $SSR_CONVERTER_BIN"
  [[ -x "$MIHOMO_CTL_BIN" ]] \
    && echo -e "${GREEN}OK${NC}  mihomo_ctl" \
    || echo -e "${RED}缺少${NC} mihomo_ctl: $MIHOMO_CTL_BIN"
  if [[ -x "$MIHOMO_BIN" ]]; then
    echo -e "${GREEN}OK${NC}  mihomo 内核: $("$MIHOMO_BIN" -v 2>&1 | head -1)"
  else
    echo -e "${RED}缺少${NC} 内核: $MIHOMO_BIN"
  fi
  [[ -f "$CONFIG_BASE" ]] \
    && echo -e "${GREEN}OK${NC}  config_base.yaml" \
    || echo -e "${YELLOW}缺少${NC} config_base.yaml（请先导入订阅）"
  [[ -f "$CONFIG_FILE" ]] \
    && echo -e "${GREEN}OK${NC}  config.yaml" \
    || echo -e "${YELLOW}缺少${NC} config.yaml（请先导入订阅）"
}

# ── SSR 转换器调用 ────────────────────────────────────────────────
run_ssr_converter() {
  local url="$1"
  if [[ ! -x "$SSR_CONVERTER_BIN" ]]; then
    echo -e "${RED}未找到 SSR 转换器: $SSR_CONVERTER_BIN${NC}"
    return 1
  fi
  "$SSR_CONVERTER_BIN" \
    --url "$url" \
    --proxies-out "$CONFIG_DIR/proxies.yaml" \
    --base "$CONFIG_BASE" \
    --output "$CONFIG_FILE"
}

run_mihomo_ctl() {
  if [[ ! -x "$MIHOMO_CTL_BIN" ]]; then
    echo -e "${RED}未找到 mihomo_ctl: $MIHOMO_CTL_BIN${NC}" >&2
    return 1
  fi
  "$MIHOMO_CTL_BIN" "$@"
}

# ── 订阅管理 ─────────────────────────────────────────────────────
import_subscription() {
  read -r -p "请输入 SSR 订阅链接: " url
  [[ -z "$url" ]] && echo "已取消" && return
  mkdir -p "$DATA_DIR"
  echo "$url" > "$SUB_FILE"
  run_ssr_converter "$url"
}

update_subscription() {
  if [[ ! -f "$SUB_FILE" ]]; then
    echo -e "${RED}还没有订阅链接，请先导入${NC}"
    return 1
  fi
  run_ssr_converter "$(cat "$SUB_FILE")"
}

# ── 服务文件写入 ──────────────────────────────────────────────────
write_launchd_plist() {
  if [[ ! -x "$MIHOMO_BIN" ]]; then
    echo -e "${RED}未找到 mihomo 内核: $MIHOMO_BIN${NC}"
    return 1
  fi
  mkdir -p "$HOME/Library/LaunchAgents" "$LOG_DIR"
  cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key><string>$PLIST_LABEL</string>
    <key>ProgramArguments</key>
    <array>
      <string>$MIHOMO_BIN</string>
      <string>-d</string>
      <string>$CONFIG_DIR</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>$LOG_DIR/stdout.log</string>
    <key>StandardErrorPath</key><string>$LOG_DIR/stderr.log</string>
  </dict>
</plist>
PLIST
  echo -e "${GREEN}LaunchAgent 已写入: $PLIST${NC}"
}

write_systemd_service() {
  if [[ ! -x "$MIHOMO_BIN" ]]; then
    echo -e "${RED}未找到 mihomo 内核: $MIHOMO_BIN${NC}"
    return 1
  fi
  mkdir -p "$(dirname "$SYSTEMD_SERVICE")"
  cat > "$SYSTEMD_SERVICE" <<SERVICE
[Unit]
Description=mihomo-box
After=network-online.target

[Service]
Type=simple
ExecStart=$MIHOMO_BIN -d $CONFIG_DIR
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
SERVICE
  systemctl --user daemon-reload
  echo -e "${GREEN}systemd 服务已写入: $SYSTEMD_SERVICE${NC}"
}

# ── 安装服务（写入启动项，不启动）────────────────────────────────
setup_service() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo -e "${RED}config.yaml 不存在，请先导入订阅${NC}"
    return 1
  fi
  if [[ "$OS_NAME" == "Darwin" ]]; then
    write_launchd_plist
  elif [[ "$OS_NAME" == "Linux" ]]; then
    write_systemd_service
    systemctl --user enable mihomo-box.service
    echo -e "${GREEN}已设为开机自启${NC}"
  else
    echo -e "${RED}暂不支持: $OS_NAME${NC}"
    return 1
  fi
}

# ── 服务启停 ──────────────────────────────────────────────────────
start_service() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    [[ ! -f "$PLIST" ]] && write_launchd_plist
    launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    launchctl kickstart -k "gui/$(id -u)/$PLIST_LABEL"
  elif [[ "$OS_NAME" == "Linux" ]]; then
    [[ ! -f "$SYSTEMD_SERVICE" ]] && write_systemd_service
    systemctl --user start mihomo-box.service
  else
    echo -e "${RED}暂不支持: $OS_NAME${NC}"; return 1
  fi
  echo -e "${GREEN}Mihomo 已启动${NC}"
}

stop_service() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true
  elif [[ "$OS_NAME" == "Linux" ]]; then
    systemctl --user stop mihomo-box.service >/dev/null 2>&1 || true
  fi
  echo -e "${GREEN}Mihomo 已停止${NC}"
}

restart_service() { stop_service; sleep 1; start_service; }

# ── 代理开关 ──────────────────────────────────────────────────────
ensure_linux_proxy_source() {
  local line="[ -f \"$PROXY_ENV_FILE\" ] && . \"$PROXY_ENV_FILE\""
  for rc in "$HOME/.bashrc" "$HOME/.profile"; do
    [[ -f "$rc" ]] || touch "$rc"
    grep -F "$PROXY_ENV_FILE" "$rc" >/dev/null 2>&1 || {
      printf '\n# mihomo-box proxy env\n%s\n' "$line" >> "$rc"
    }
  done
}

proxy_on() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    networksetup -setwebproxy          "$NET_SERVICE" 127.0.0.1 "$PORT"
    networksetup -setsecurewebproxy    "$NET_SERVICE" 127.0.0.1 "$PORT"
    networksetup -setsocksfirewallproxy "$NET_SERVICE" 127.0.0.1 "$PORT"
    networksetup -setwebproxystate          "$NET_SERVICE" on
    networksetup -setsecurewebproxystate    "$NET_SERVICE" on
    networksetup -setsocksfirewallproxystate "$NET_SERVICE" on
    echo -e "${GREEN}系统代理已打开: $NET_SERVICE -> 127.0.0.1:$PORT${NC}"
    return
  fi
  if [[ "$OS_NAME" == "Linux" ]]; then
    mkdir -p "$PROXY_ENV_DIR"
    cat > "$PROXY_ENV_FILE" <<PROXY
export http_proxy="http://127.0.0.1:$PORT"
export https_proxy="http://127.0.0.1:$PORT"
export all_proxy="socks5h://127.0.0.1:$PORT"
export HTTP_PROXY="\$http_proxy"
export HTTPS_PROXY="\$https_proxy"
export ALL_PROXY="\$all_proxy"
export no_proxy="localhost,127.0.0.1,::1"
export NO_PROXY="\$no_proxy"
PROXY
    ensure_linux_proxy_source
    echo -e "${GREEN}命令行代理已打开: 127.0.0.1:$PORT${NC}"
    echo "新 terminal 自动生效；当前 terminal 执行: source \"$PROXY_ENV_FILE\""
    return
  fi
  echo -e "${RED}暂不支持: $OS_NAME${NC}"
}

proxy_off() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    networksetup -setwebproxystate          "$NET_SERVICE" off
    networksetup -setsecurewebproxystate    "$NET_SERVICE" off
    networksetup -setsocksfirewallproxystate "$NET_SERVICE" off
    echo -e "${GREEN}系统代理已关闭: $NET_SERVICE${NC}"
    return
  fi
  if [[ "$OS_NAME" == "Linux" ]]; then
    : > "$PROXY_ENV_FILE"
    echo -e "${GREEN}命令行代理已关闭${NC}"
    echo "新 terminal 自动生效；当前 terminal 执行: unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY"
    return
  fi
  echo -e "${RED}暂不支持: $OS_NAME${NC}"
}

# ── 状态检测 ──────────────────────────────────────────────────────
api_ok()     { curl -s --max-time 2 "$API/proxies/$GROUP" >/dev/null 2>&1; }

service_ok() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    launchctl print "gui/$(id -u)/$PLIST_LABEL" >/dev/null 2>&1
  elif [[ "$OS_NAME" == "Linux" ]]; then
    systemctl --user is-active --quiet mihomo-box.service 2>/dev/null
  else
    return 1
  fi
}

proxy_ok() {
  if [[ "$OS_NAME" == "Darwin" ]]; then
    [[ "$(networksetup -getwebproxy "$NET_SERVICE" 2>/dev/null | awk -F': ' '/^Enabled:/{print $2; exit}')" == "Yes" ]]
  else
    [[ -s "$PROXY_ENV_FILE" ]]
  fi
}

current_node() {
  api_ok || { echo "API 未连接"; return 1; }
  local tmp
  tmp="$(mktemp)"
  curl -s "$API/proxies/$GROUP" > "$tmp"
  local node
  node="$(run_mihomo_ctl now "$tmp" 2>/dev/null)" || true
  rm -f "$tmp"
  [[ -n "$node" ]] && echo "$node" || echo "未知"
}

status_bar() {
  local svc proxy node
  service_ok && svc="${GREEN}开启${NC}" || svc="${RED}关闭${NC}"
  proxy_ok   && proxy="${GREEN}开启${NC}" || proxy="${RED}关闭${NC}"
  node="$(current_node 2>/dev/null || echo '-')"
  echo -e "Mihomo 服务：$svc"
  [[ "$OS_NAME" == "Linux" ]] \
    && echo -e "命令行代理：$proxy" \
    || echo -e "macOS 系统代理：$proxy"
  echo -e "当前节点：${YELLOW}${node}${NC}"
}

# ── 节点选择 ──────────────────────────────────────────────────────
select_node() {
  api_ok || { echo -e "${RED}无法连接 API: $API — 请先启动服务${NC}"; return 1; }
  local tmp idx selected
  tmp="$(mktemp)"
  curl -s "$API/proxies/$GROUP" > "$tmp"
  run_mihomo_ctl list "$tmp"
  read -r -p "请选择节点编号: " idx
  [[ "$idx" == "0" || -z "$idx" ]] && rm -f "$tmp" && return
  selected="$(run_mihomo_ctl pick "$tmp" "$idx")" || { echo -e "${RED}编号无效${NC}"; rm -f "$tmp"; return 1; }
  rm -f "$tmp"
  run_mihomo_ctl payload "$selected" > /tmp/mihomo_select_payload.json
  curl -s -X PUT "$API/proxies/$GROUP" \
    -H "Content-Type: application/json" \
    --data-binary @/tmp/mihomo_select_payload.json >/dev/null
  rm -f /tmp/mihomo_select_payload.json
  echo -e "${GREEN}已切换到: $selected${NC}"
}

# ── 日志 / 配置 ───────────────────────────────────────────────────
logs() {
  if [[ "$OS_NAME" == "Linux" ]]; then
    journalctl --user -u mihomo-box.service -n 80 --no-pager 2>/dev/null || echo "暂无"
    return
  fi
  echo "=== stderr (last 60) ==="; tail -n 60 "$LOG_DIR/stderr.log" 2>/dev/null || echo "暂无"
  echo; echo "=== stdout (last 20) ==="; tail -n 20 "$LOG_DIR/stdout.log" 2>/dev/null || echo "暂无"
}

edit_base_config() {
  if [[ ! -f "$CONFIG_BASE" ]]; then
    echo -e "${RED}$CONFIG_BASE 不存在${NC}"
    return 1
  fi
  ${EDITOR:-nano} "$CONFIG_BASE"
  echo
  echo "修改已保存。如需生效请执行更新订阅（选项 3）重新合并 config.yaml，然后重启服务（选项 7）。"
  pause
}

# ── 主菜单 ────────────────────────────────────────────────────────
while true; do
  clear 2>/dev/null || true
  line
  echo -e "${GREEN}  Mihomo-Box 管理菜单${NC}"
  line
  status_bar
  small_line
  echo "  目录: $BASE_DIR   平台: $OS_NAME/$ARCH_NAME"
  line
  echo "  1.  检查环境"
  echo "  2.  导入 SSR 订阅（首次 / 换订阅）"
  echo "  3.  更新订阅并重新生成配置"
  small_line
  echo "  4.  安装服务（写入启动项）"
  echo "  5.  启动服务"
  echo "  6.  停止服务"
  echo "  7.  重启服务"
  small_line
  if [[ "$OS_NAME" == "Linux" ]]; then
    echo "  8.  打开命令行代理"
    echo "  9.  关闭命令行代理"
  else
    echo "  8.  打开 macOS 系统代理"
    echo "  9.  关闭 macOS 系统代理"
  fi
  small_line
  echo "  10. 选择节点"
  echo "  11. 查看日志"
  echo "  12. 编辑基础配置 (config_base.yaml)"
  echo "  0.  退出"
  line
  read -r -p "  请输入选择 [0-12]: " c
  case "$c" in
    1)  check_env;         pause ;;
    2)  import_subscription; pause ;;
    3)  update_subscription; pause ;;
    4)  setup_service;     pause ;;
    5)  start_service;     pause ;;
    6)  stop_service;      pause ;;
    7)  restart_service;   pause ;;
    8)  proxy_on;          pause ;;
    9)  proxy_off;         pause ;;
    10) select_node;       pause ;;
    11) logs;              pause ;;
    12) edit_base_config ;;
    0)  exit 0 ;;
    *)  echo "无效选择"; pause ;;
  esac
done
