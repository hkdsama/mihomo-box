#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG_DIR="$BASE_DIR/config"
DATA_DIR="$BASE_DIR/data"
LOG_DIR="$BASE_DIR/logs"
SERVICE_DIR="$BASE_DIR/service"
CONFIG_FILE="$CONFIG_DIR/config.yaml"
SUB_FILE="$DATA_DIR/subscription.url"
case "$(uname -s):$(uname -m)" in
  Darwin:arm64|Darwin:aarch64) MIHOMO_BIN="$BASE_DIR/bin/mihomo-darwin-arm64" ;;
  Linux:x86_64|Linux:amd64) MIHOMO_BIN="$BASE_DIR/bin/mihomo-linux-amd64-v3" ;;
  *) MIHOMO_BIN="$BASE_DIR/bin/mihomo" ;;
esac
SSR_CONVERTER_BIN="$BASE_DIR/bin/ssr_2_mihomo"
SSR_CONVERTER_SRC="$BASE_DIR/cmd/ssr_2_mihomo/main.go"
MIHOMO_CTL_BIN="$BASE_DIR/bin/mihomo_ctl"
MIHOMO_CTL_SRC="$BASE_DIR/cmd/mihomo_ctl/main.go"
PLIST="$HOME/Library/LaunchAgents/com.local.mihomo.box.plist"
API="http://127.0.0.1:9090"
GROUP="PROXY"
PORT="7890"

GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'

mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$LOG_DIR" "$SERVICE_DIR"

line(){ printf '%*s\n' "${COLUMNS:-72}" '' | tr ' ' '='; }
small_line(){ printf '%*s\n' "${COLUMNS:-72}" '' | tr ' ' '-'; }
pause(){ echo; read -r -p "按 Enter 返回菜单..." _; }

network_service() {
  local iface service
  iface="$(route get default 2>/dev/null | awk '/interface:/{print $2; exit}')"
  if [[ -n "${iface:-}" ]]; then
    service="$(networksetup -listallhardwareports | awk -v dev="$iface" '
      BEGIN { RS=""; FS="\n" }
      $0 ~ "Device: " dev { for (i=1;i<=NF;i++) if ($i ~ /^Hardware Port:/) { sub(/^Hardware Port: /,"",$i); print $i; exit } }
    ')"
  fi
  [[ -n "${service:-}" ]] && echo "$service" || echo "Wi-Fi"
}
NET_SERVICE="${MIHOMO_NET_SERVICE:-$(network_service)}"

check_env() {
  echo "工作目录: $BASE_DIR"
  echo "网络服务: $NET_SERVICE"
  echo
  for c in curl networksetup launchctl awk sed; do
    if command -v "$c" >/dev/null 2>&1; then echo -e "${GREEN}OK${NC} $c"; else echo -e "${RED}缺少${NC} $c"; fi
  done
  if [[ -x "$SSR_CONVERTER_BIN" ]]; then
    echo -e "${GREEN}OK${NC} Go SSR 转换器: $SSR_CONVERTER_BIN"
  elif command -v go >/dev/null 2>&1 && [[ -f "$SSR_CONVERTER_SRC" ]]; then
    echo -e "${GREEN}OK${NC} Go 工具链，可直接运行: $SSR_CONVERTER_SRC"
  else
    echo -e "${YELLOW}缺少 Go SSR 转换器${NC}"
    echo "可在 macOS 上执行: go build -o bin/ssr_2_mihomo cmd/ssr_2_mihomo/main.go"
  fi
  if [[ -x "$MIHOMO_CTL_BIN" ]]; then
    echo -e "${GREEN}OK${NC} Go 菜单辅助工具: $MIHOMO_CTL_BIN"
  elif command -v go >/dev/null 2>&1 && [[ -f "$MIHOMO_CTL_SRC" ]]; then
    echo -e "${GREEN}OK${NC} Go 工具链，可直接运行: $MIHOMO_CTL_SRC"
  else
    echo -e "${YELLOW}缺少 Go 菜单辅助工具${NC}"
    echo "可在 macOS 上执行: go build -o bin/mihomo_ctl cmd/mihomo_ctl/main.go"
  fi
  if [[ -x "$MIHOMO_BIN" ]]; then "$MIHOMO_BIN" -v || true; else echo -e "${YELLOW}未找到内核: $MIHOMO_BIN${NC}"; echo "可执行: ./bin/fetch-mihomo.sh"; fi
}

run_ssr_converter() {
  local url="$1"
  if command -v go >/dev/null 2>&1 && [[ -f "$SSR_CONVERTER_SRC" ]]; then
    if [[ ! -x "$SSR_CONVERTER_BIN" || "$SSR_CONVERTER_SRC" -nt "$SSR_CONVERTER_BIN" ]]; then
      go run "$SSR_CONVERTER_SRC" --url "$url" --output "$CONFIG_FILE" --mixed-port "$PORT" --api "${API#http://}" --group "$GROUP"
      return
    fi
  fi
  if [[ -x "$SSR_CONVERTER_BIN" ]]; then
    "$SSR_CONVERTER_BIN" --url "$url" --output "$CONFIG_FILE" --mixed-port "$PORT" --api "${API#http://}" --group "$GROUP"
    return
  fi
  if command -v go >/dev/null 2>&1 && [[ -f "$SSR_CONVERTER_SRC" ]]; then
    go run "$SSR_CONVERTER_SRC" --url "$url" --output "$CONFIG_FILE" --mixed-port "$PORT" --api "${API#http://}" --group "$GROUP"
    return
  fi
  echo -e "${RED}未找到 Go SSR 转换器${NC}"
  echo "请先在 macOS 上执行:"
  echo "  go build -o bin/ssr_2_mihomo cmd/ssr_2_mihomo/main.go"
  return 1
}

run_mihomo_ctl() {
  if command -v go >/dev/null 2>&1 && [[ -f "$MIHOMO_CTL_SRC" ]]; then
    if [[ ! -x "$MIHOMO_CTL_BIN" || "$MIHOMO_CTL_SRC" -nt "$MIHOMO_CTL_BIN" ]]; then
      go run "$MIHOMO_CTL_SRC" "$@"
      return
    fi
  fi
  if [[ -x "$MIHOMO_CTL_BIN" ]]; then
    "$MIHOMO_CTL_BIN" "$@"
    return
  fi
  if command -v go >/dev/null 2>&1 && [[ -f "$MIHOMO_CTL_SRC" ]]; then
    go run "$MIHOMO_CTL_SRC" "$@"
    return
  fi
  echo -e "${RED}未找到 Go 菜单辅助工具${NC}" >&2
  echo "请先在 macOS 上执行:" >&2
  echo "  go build -o bin/mihomo_ctl cmd/mihomo_ctl/main.go" >&2
  return 1
}

import_subscription() {
  read -r -p "请输入 SSR 订阅链接: " url
  [[ -z "$url" ]] && echo "已取消" && return
  echo "$url" > "$SUB_FILE"
  run_ssr_converter "$url"
}

update_subscription() {
  if [[ ! -f "$SUB_FILE" ]]; then echo -e "${RED}还没有订阅链接，请先导入${NC}"; return 1; fi
  run_ssr_converter "$(cat "$SUB_FILE")"
}

write_plist() {
  if [[ ! -x "$MIHOMO_BIN" ]]; then echo -e "${RED}未找到 mihomo 内核: $MIHOMO_BIN${NC}"; return 1; fi
  if [[ ! -f "$CONFIG_FILE" ]]; then cp "$CONFIG_DIR/config.yaml.example" "$CONFIG_FILE"; fi
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key><string>com.local.mihomo.box</string>
    <key>ProgramArguments</key>
    <array>
      <string>$MIHOMO_BIN</string>
      <string>-d</string>
      <string>$CONFIG_DIR</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>$LOG_DIR/stdout.log</string>
    <key>StandardErrorPath</key><string>$LOG_DIR/stderr.log</string>
  </dict>
</plist>
PLIST
}

start_service(){ write_plist; launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true; launchctl bootstrap "gui/$(id -u)" "$PLIST"; launchctl enable "gui/$(id -u)/com.local.mihomo.box"; launchctl kickstart -k "gui/$(id -u)/com.local.mihomo.box"; echo -e "${GREEN}Mihomo 服务已启动${NC}"; }
stop_service(){ launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true; echo -e "${GREEN}Mihomo 服务已停止${NC}"; }
restart_service(){ stop_service; sleep 1; start_service; }

proxy_on(){ networksetup -setwebproxy "$NET_SERVICE" 127.0.0.1 "$PORT"; networksetup -setsecurewebproxy "$NET_SERVICE" 127.0.0.1 "$PORT"; networksetup -setsocksfirewallproxy "$NET_SERVICE" 127.0.0.1 "$PORT"; networksetup -setwebproxystate "$NET_SERVICE" on; networksetup -setsecurewebproxystate "$NET_SERVICE" on; networksetup -setsocksfirewallproxystate "$NET_SERVICE" on; echo -e "${GREEN}系统代理已打开: $NET_SERVICE -> 127.0.0.1:$PORT${NC}"; }
proxy_off(){ networksetup -setwebproxystate "$NET_SERVICE" off; networksetup -setsecurewebproxystate "$NET_SERVICE" off; networksetup -setsocksfirewallproxystate "$NET_SERVICE" off; echo -e "${GREEN}系统代理已关闭: $NET_SERVICE${NC}"; }

api_ok(){ curl -s --max-time 2 "$API/proxies/$GROUP" >/dev/null 2>&1; }

service_ok(){ launchctl print "gui/$(id -u)/com.local.mihomo.box" >/dev/null 2>&1; }

web_proxy_enabled() {
  local value
  value="$(networksetup -getwebproxy "$NET_SERVICE" 2>/dev/null | awk -F': ' '/^Enabled:/{print $2; found=1; exit} END{if (!found) print "No"}' || true)"
  echo "${value:-No}"
}

proxy_ok(){ [[ "$(web_proxy_enabled)" == "Yes" ]]; }

current_node() {
  if ! api_ok; then
    echo "API 未连接"
    return 1
  fi
  local tmp node rc
  tmp="$(mktemp)"
  curl -s "$API/proxies/$GROUP" > "$tmp" || {
    rm -f "$tmp"
    echo "API 未连接"
    return 1
  }
  node="$(run_mihomo_ctl now "$tmp" 2>/dev/null)" || rc=$?
  rm -f "$tmp"
  if [[ -n "${rc:-}" || -z "$node" ]]; then
    echo "未知"
    return 1
  fi
  echo "$node"
}

status_bar() {
  local service_text proxy_text node
  if service_ok; then service_text="${GREEN}开启${NC}"; else service_text="${RED}关闭${NC}"; fi
  if proxy_ok; then proxy_text="${GREEN}开启${NC}"; else proxy_text="${RED}关闭${NC}"; fi
  node="$(current_node || true)"

  echo -e "mihomo 服务：$service_text"
  echo -e "macOS 系统代理：$proxy_text"
  echo -e "当前站点：${YELLOW}${node}${NC}"
}

select_node() {
  if ! api_ok; then echo -e "${RED}无法连接 Mihomo API: $API${NC}"; echo "请先启动服务。"; return 1; fi
  local tmp idx selected
  tmp="$(mktemp)"
  curl -s "$API/proxies/$GROUP" > "$tmp"
  run_mihomo_ctl list "$tmp"
  read -r -p "请选择节点编号: " idx
  [[ "$idx" == "0" || -z "$idx" ]] && rm -f "$tmp" && return
  selected="$(run_mihomo_ctl pick "$tmp" "$idx")" || { echo -e "${RED}编号无效${NC}"; rm -f "$tmp"; return 1; }
  rm -f "$tmp"
  run_mihomo_ctl payload "$selected" > /tmp/mihomo_select_payload.json
  curl -s -X PUT "$API/proxies/$GROUP" -H "Content-Type: application/json" --data-binary @/tmp/mihomo_select_payload.json >/dev/null
  rm -f /tmp/mihomo_select_payload.json
  echo -e "${GREEN}已切换到: $selected${NC}"
}

status() {
  echo "工作目录: $BASE_DIR"
  echo "配置文件: $CONFIG_FILE"
  echo "网络服务: $NET_SERVICE"
  echo "API: $API"
  echo
  echo -e "${BLUE}服务:${NC}"
  if service_ok; then echo -e "${GREEN}运行中${NC}"; else echo -e "${YELLOW}未运行${NC}"; fi
  echo
  echo -e "${BLUE}HTTP 代理:${NC}"
  networksetup -getwebproxy "$NET_SERVICE" || true
  echo
  echo -e "${BLUE}当前节点:${NC}"
  current_node || true
}

logs(){ echo "stderr:"; tail -n 60 "$LOG_DIR/stderr.log" 2>/dev/null || echo "暂无"; echo; echo "stdout:"; tail -n 20 "$LOG_DIR/stdout.log" 2>/dev/null || echo "暂无"; }
edit_config(){ ${EDITOR:-nano} "$CONFIG_FILE"; }
open_dir(){ open "$BASE_DIR"; }

while true; do
  clear 2>/dev/null || true
  line
  echo -e "${GREEN}Mihomo SSR macOS 管理器${NC}"
  line
  status_bar
  small_line
  echo "目录: $BASE_DIR"
  echo "网络: $NET_SERVICE"
  line
  echo "1. 检查环境"
  echo "2. 导入 SSR 订阅链接，并生成配置（Go）"
  echo "3. 更新订阅并重新生成配置"
  echo "4. 启动 Mihomo 服务"
  echo "5. 停止 Mihomo 服务"
  echo "6. 重启 Mihomo 服务"
  echo "7. 打开 macOS 系统代理"
  echo "8. 关闭 macOS 系统代理"
  echo "9. 选择代理站点 / 节点"
  echo "10. 刷新状态"
  echo "11. 查看日志"
  echo "12. 编辑 config.yaml"
  echo "13. 打开工作目录"
  echo "0. 退出"
  line
  read -r -p "请输入选择 [0-13]: " c
  case "$c" in
    1) check_env; pause;;
    2) import_subscription; pause;;
    3) update_subscription; pause;;
    4) start_service; pause;;
    5) stop_service; pause;;
    6) restart_service; pause;;
    7) proxy_on; pause;;
    8) proxy_off; pause;;
    9) select_node; pause;;
    10) status; pause;;
    11) logs; pause;;
    12) edit_config;;
    13) open_dir; pause;;
    0) exit 0;;
    *) echo "无效选择"; pause;;
  esac
done
